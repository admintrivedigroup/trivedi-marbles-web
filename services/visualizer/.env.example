# "local" runs SAM2 + Depth Anything V2 on-GPU in this process.
# "replicate" calls Replicate for both instead (works with no GPU).
VISUALIZER_INFERENCE_MODE=replicate

# Shared secret checked against the X-Visualizer-Secret header sent by the
# Next.js API route (src/app/api/visualizer/jobs/route.ts). Required once this
# service is deployed anywhere with a reachable URL (e.g. Modal) — the Modal
# URL is public, so this is the only thing gating access to it.
VISUALIZER_SERVICE_SECRET=

# Required in "replicate" mode, and always required for Grounding DINO
# occlusion detection (local or replicate mode) and the Replicate fallback path.
REPLICATE_API_TOKEN=

# Same Replicate version-pin convention already used by the existing
# /inventory visualizer (src/app/inventory/_actions/{detectObjects,getDepthMap}.ts).
# Grounding DINO occlusion detection is skipped gracefully if unset.
GROUNDING_DINO_VERSION=
# Only read in VISUALIZER_INFERENCE_MODE=replicate; skipped gracefully if unset.
DEPTH_ANYTHING_V2_VERSION=

# "local" mode only — Hugging Face model ids. Defaults shown below.
VISUALIZER_SAM2_CHECKPOINT=facebook/sam2.1-hiera-base-plus
VISUALIZER_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Base-hf
